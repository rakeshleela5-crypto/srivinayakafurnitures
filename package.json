{
  "name": "omnibuild-os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "vite build && npx wrangler pages deploy dist --project-name=srivinayakafurnitures --commit-dirty=true",
    "deploy:pages": "vite build && npx wrangler pages deploy dist --project-name=srivinayakafurnitures --commit-dirty=true",
    "deploy:cron": "cd cron-worker && npx wrangler deploy",
    "deploy:all": "npm run deploy && npm run deploy:cron",
    "deploy:firebase": "vite build && firebase deploy --only hosting",
    "test": "node --test tests/unit/**/*.test.js tests/api/**/*.test.js tests/chaos/**/*.test.js",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:api": "node --test tests/api/**/*.test.js",
    "test:chaos": "node --test tests/chaos/**/*.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@zxing/library": "^0.23.0",
    "canvas-confetti": "^1.9.4",
    "hono": "^4.13.11",
    "lucide-react": "^1.34.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "pdfkit": "^0.20.2",
    "vite": "^8.2.2"
  }
}
